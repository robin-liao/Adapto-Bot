{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "padding": "Default",
  "version": "1.3",
  "style": "emphasis",
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Was this helpful?",
                  "weight": "Bolder",
                  "wrap": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "spacing": "Small",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.Submit",
                      "title": "👍",
                      "tooltip": "Helpful",
                      "data": {
                        "action": "feedback_helpful"
                      }
                    },
                    {
                      "type": "Action.Submit",
                      "title": "👎",
                      "tooltip": "Incorrect",
                      "data": {
                        "action": "feedback_incorrect"
                      }
                    },
                    {
                      "type": "Action.Submit",
                      "title": "📖",
                      "tooltip": "Too much to read",
                      "data": {
                        "action": "feedback_too_much"
                      }
                    },
                    {
                      "type": "Action.Submit",
                      "title": "ℹ️",
                      "tooltip": "Need more details",
                      "data": {
                        "action": "feedback_more_detail"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
